# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored, and the pre-commit hook refuses any commit that contains
# one of its values. Keep every key and personal id here, never in code or JSON.

# --- Required ---
# OpenRouter API key (https://openrouter.ai/settings/keys). Give the key a credit limit.
OPENROUTER_API_KEY=
# Skill ID from the Alexa Developer Console (amzn1.ask.skill.…). Required for the tunnel.
BRIDGE_SKILL_ID=

# --- You ---
# IANA time zone: decides what "today" is for conversation memory and the date the model is told.
BRIDGE_TIMEZONE=UTC
# Optional. Country or city the model is told you are in, e.g. India.
BRIDGE_USER_LOCATION=

# --- Model (OpenRouter) ---
BRIDGE_MODEL=deepseek/deepseek-v4.1-flash
# Pin providers in order; empty = OpenRouter default routing (may pick fp4 hosts).
# DeepSeek's own API is excluded by OpenRouter's "no training on paid prompts"
# privacy setting; DeepInfra (fp8) serves the same model without training on it.
BRIDGE_PROVIDER_ORDER=deepinfra
BRIDGE_PROVIDER_FALLBACKS=false
# off | minimal | low | medium | high | <token budget, e.g. 256>
BRIDGE_REASONING=low
BRIDGE_MAX_OUTPUT_TOKENS=700

# --- Built-in OpenRouter tools ---
# Web search via Parallel "turbo" ($0.001 per search, English).
BRIDGE_WEB_SEARCH=true
BRIDGE_WEB_SEARCH_ENGINE=parallel
BRIDGE_WEB_SEARCH_MODE=turbo
BRIDGE_WEB_SEARCH_MAX_RESULTS=3
# Searches per question. Each one adds a model pass (~1.5-2 s); 2 pushed answers past the deadline.
BRIDGE_WEB_SEARCH_MAX_USES=1
# OpenRouter web fetch (free, adds a tool definition to every request).
BRIDGE_WEB_FETCH=false

# --- MCP servers (see mcp_servers.example.json and README "MCP tools") ---
# BRIDGE_MCP_CONFIG=./mcp_servers.json
# Simplenote task list: the id of the one note to use (find it with: make find-note QUERY=Tasks).
SIMPLENOTE_TASK_NOTE_ID=

# --- Timing (Alexa allows ~8 s per response) ---
# Past this, the skill says "say go on". 7.0 leaves ~1 s for the tunnel and Alexa.
BRIDGE_DEADLINE_SECONDS=7.0
BRIDGE_FILLER_AFTER_SECONDS=2.5

# --- Conversation ---
BRIDGE_HISTORY_TURNS=15

# --- Local server ---
BRIDGE_PORT=8787
# Keep true whenever the tunnel is up. false only for scripts/replay.py on localhost.
BRIDGE_VERIFY_SIGNATURES=true

# --- Spend cap ---
# Paid model calls stop once recorded OpenRouter spend reaches this many USD.
# The total is kept in the store (data/bridge.sqlite3 locally, DynamoDB on AWS).
# Set it a little below your OpenRouter key's own credit limit. 0 = no cap.
BRIDGE_SPEND_CAP_USD=1.00
